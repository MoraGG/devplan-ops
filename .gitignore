# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# 数据库运行时产物（种子与 DDL 已入库，devplan.db 作为初始状态随仓库分发）
db/*.bak
db/*.db-wal
db/*.db-shm
# 本地 QA 冒烟用的临时库副本
db/_smoke.db
# 中继/部署临时脚本与补丁（含服务器口令 / GitHub PAT，严禁入库）
_relay.mbox
_relay_push.py
db/_deploy_now.py
db/_deploy_srv.py
db/_relay_push.py
# 本地 SQLite 测试 / 重建备份副本（devplan.db 本体随仓库分发，副本不入库）
db/devplan.db.*
# 重建前备份（backup_mysql.py 的产物，含业务数据，不入库）
db/_backup/

# 平台/会话文件
.codebuddy/
.workbuddy/
.DS_Store

# 本地环境变量（连接口令等，不入库）
.env
*.log
