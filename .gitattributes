# 统一行尾为 LF（服务器为 Linux，CRLF 会导致 shell 脚本 / systemd 单元失效）
* text=auto eol=lf

*.sh      text eol=lf
*.service text eol=lf
*.py      text eol=lf
*.sql     text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.md      text eol=lf
*.txt     text eol=lf

# 二进制文件不做行尾转换
*.db      binary
*.sqlite  binary
*.xlsx    binary
*.png     binary
*.jpg     binary
*.pdf     binary
